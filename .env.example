APP_NAME=Instagram Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# Local development credentials only. Replace before using outside your machine.
POSTGRES_DB=instagram
POSTGRES_USER=instagram
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://instagram:local-development-only@localhost:5432/instagram
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-development-only
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-development-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-development-only

# Required by the authentication module. Generate locally; never reuse this example.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=instagram-backend
AUTH_JWT_AUDIENCE=instagram-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
