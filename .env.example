APP_NAME=Instagram Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# Local development credentials only. Replace before using outside your machine.
POSTGRES_DB=instagram
POSTGRES_USER=instagram
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://instagram:local-development-only@localhost:5432/instagram
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-development-only
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=local-development-only
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
MEDIA_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
MEDIA_STORAGE_BUCKET=instagram-media
MEDIA_STORAGE_REGION=us-east-1
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_DOWNLOAD_TTL_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_CLEANUP_GRACE_HOURS=24
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-development-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-development-only

# Generate a unique random secret; the placeholder is rejected at startup.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=instagram-backend
AUTH_JWT_AUDIENCE=instagram-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
